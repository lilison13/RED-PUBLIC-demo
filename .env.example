OREF_MONITOR_BASE_DIR=/opt/oref-monitor

BEREADY_MAILER_HOST=0.0.0.0
BEREADY_MAILER_PORT=8788
BEREADY_MAILER_URL=http://beready-mailer:8788/snapshot
BEREADY_SNAPSHOT_POLL_SEC=5
BEREADY_ENABLE_MAIL=false

BEREADY_SMTP_HOST=mail.example.com
BEREADY_SMTP_PORT=587
BEREADY_SMTP_SECURITY=starttls
BEREADY_SMTP_USER=your-user@example.com
BEREADY_SMTP_PASS=
BEREADY_SMTP_FROM=your-user@example.com
BEREADY_SMTP_TO=target@example.com

BEREADY_MAIL_SUBJECT_PREFIX=BeReady
